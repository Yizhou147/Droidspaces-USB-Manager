[Desktop Entry]
Name=USB Manager
Name[zh_CN]=USB 管理器
Comment=Droidspaces USB Device Manager
Comment[zh_CN]=Droidspaces USB 设备管理器
Exec=/usr/bin/usb-manager
Icon=/usr/share/usb-manager/icons/usb-manager.svg
Terminal=false
Type=Application
Categories=System;
Keywords=usb;storage;mount;adb;android;mtp;fastboot;
StartupNotify=true
